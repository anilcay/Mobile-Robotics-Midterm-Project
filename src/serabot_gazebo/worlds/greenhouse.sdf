<?xml version="1.0"?>
<!--
  SeraBot greenhouse world, Blender visuals on primitive collisions (owner: S2).
  greenhouse.sdf is GENERATED by tools/generate_greenhouse.py; edit the generator.
  Interior 10 x 6 m, three plant beds along x, pots as corridor obstacles,
  pure red tomatoes at camera height. Collision geometry is primitive (ADR-018).
-->
<sdf version="1.10">
  <world name="greenhouse">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.75 0.85 0.95 1</background>
      <shadows>false</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
          <material><ambient>0.55 0.55 0.52 1</ambient><diffuse>0.55 0.55 0.52 1</diffuse><specular>0.05 0.05 0.05 1</specular></material>
        </visual>
      </link>
    </model>

    <model name="walls">
      <static>true</static>
      <link name="link">
        <collision name="north_collision"><pose>0 3.05 0.5 0 0 0</pose><geometry><box><size>10.2 0.1 1</size></box></geometry></collision>
        <visual name="north_visual"><pose>0 3.05 0.5 0 0 0</pose><geometry><box><size>10.2 0.1 1</size></box></geometry><material><ambient>0.8 0.82 0.8 1</ambient><diffuse>0.8 0.82 0.8 1</diffuse><specular>0.05 0.05 0.05 1</specular></material></visual>
        <collision name="south_collision"><pose>0 -3.05 0.5 0 0 0</pose><geometry><box><size>10.2 0.1 1</size></box></geometry></collision>
        <visual name="south_visual"><pose>0 -3.05 0.5 0 0 0</pose><geometry><box><size>10.2 0.1 1</size></box></geometry><material><ambient>0.8 0.82 0.8 1</ambient><diffuse>0.8 0.82 0.8 1</diffuse><specular>0.05 0.05 0.05 1</specular></material></visual>
        <collision name="east_collision"><pose>5.05 0 0.5 0 0 0</pose><geometry><box><size>0.1 6 1</size></box></geometry></collision>
        <visual name="east_visual"><pose>5.05 0 0.5 0 0 0</pose><geometry><box><size>0.1 6 1</size></box></geometry><material><ambient>0.8 0.82 0.8 1</ambient><diffuse>0.8 0.82 0.8 1</diffuse><specular>0.05 0.05 0.05 1</specular></material></visual>
        <collision name="west_collision"><pose>-5.05 0 0.5 0 0 0</pose><geometry><box><size>0.1 6 1</size></box></geometry></collision>
        <visual name="west_visual"><pose>-5.05 0 0.5 0 0 0</pose><geometry><box><size>0.1 6 1</size></box></geometry><material><ambient>0.8 0.82 0.8 1</ambient><diffuse>0.8 0.82 0.8 1</diffuse><specular>0.05 0.05 0.05 1</specular></material></visual>
      </link>
    </model>
    <model name="bed_0">
      <static>true</static>
      <pose>0 -1.75 0 0 0 0</pose>
      <link name="link">
        <collision name="collision"><pose>0 0 0.2 0 0 0</pose><geometry><box><size>6 0.5 0.4</size></box></geometry></collision>
        <visual name="planter"><pose>0 0 0 0 0 0</pose><geometry><mesh><uri>model://planter_bed/meshes/planter_bed.obj</uri></mesh></geometry></visual>
        <visual name="plants"><pose>0 0 0 0 0 0</pose><geometry><mesh><uri>model://tomato_row/meshes/tomato_row.obj</uri></mesh></geometry></visual>
      </link>
    </model>
    <model name="bed_1">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <collision name="collision"><pose>0 0 0.2 0 0 0</pose><geometry><box><size>6 0.5 0.4</size></box></geometry></collision>
        <visual name="planter"><pose>0 0 0 0 0 0</pose><geometry><mesh><uri>model://planter_bed/meshes/planter_bed.obj</uri></mesh></geometry></visual>
        <visual name="plants"><pose>0 0 0 0 0 3.1416</pose><geometry><mesh><uri>model://tomato_row/meshes/tomato_row.obj</uri></mesh></geometry></visual>
      </link>
    </model>
    <model name="bed_2">
      <static>true</static>
      <pose>0 1.75 0 0 0 0</pose>
      <link name="link">
        <collision name="collision"><pose>0 0 0.2 0 0 0</pose><geometry><box><size>6 0.5 0.4</size></box></geometry></collision>
        <visual name="planter"><pose>0 0 0 0 0 0</pose><geometry><mesh><uri>model://planter_bed/meshes/planter_bed.obj</uri></mesh></geometry></visual>
        <visual name="plants"><pose>0 0 0 0 0 0</pose><geometry><mesh><uri>model://tomato_row/meshes/tomato_row.obj</uri></mesh></geometry></visual>
      </link>
    </model>
    <model name="pot_0">
      <static>true</static>
      <pose>-0.5 1.3 0.175 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.15</radius><length>0.35</length></cylinder></geometry></collision>
        <visual name="visual"><pose>0 0 0 0 0 0</pose><geometry><mesh><uri>model://plant_pot/meshes/plant_pot.obj</uri></mesh></geometry></visual>
      </link>
    </model>
    <model name="pot_1">
      <static>true</static>
      <pose>1 -0.45 0.175 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.15</radius><length>0.35</length></cylinder></geometry></collision>
        <visual name="visual"><pose>0 0 0 0 0 0</pose><geometry><mesh><uri>model://plant_pot/meshes/plant_pot.obj</uri></mesh></geometry></visual>
      </link>
    </model>
    <model name="pot_2">
      <static>true</static>
      <pose>-1.6 -1.3 0.175 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.15</radius><length>0.35</length></cylinder></geometry></collision>
        <visual name="visual"><pose>0 0 0 0 0 0</pose><geometry><mesh><uri>model://plant_pot/meshes/plant_pot.obj</uri></mesh></geometry></visual>
      </link>
    </model>
    <model name="pot_3">
      <static>true</static>
      <pose>4.2 -1.2 0.175 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.15</radius><length>0.35</length></cylinder></geometry></collision>
        <visual name="visual"><pose>0 0 0 0 0 0</pose><geometry><mesh><uri>model://plant_pot/meshes/plant_pot.obj</uri></mesh></geometry></visual>
      </link>
    </model>
    <model name="pot_4">
      <static>true</static>
      <pose>-4.2 -1.8 0.175 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.15</radius><length>0.35</length></cylinder></geometry></collision>
        <visual name="visual"><pose>0 0 0 0 0 0</pose><geometry><mesh><uri>model://plant_pot/meshes/plant_pot.obj</uri></mesh></geometry></visual>
      </link>
    </model>
    <model name="greenhouse_frame">
      <static>true</static>
      <link name="link">
        <visual name="visual"><pose>0 0 0 0 0 0</pose><geometry><mesh><uri>model://greenhouse_frame/meshes/greenhouse_frame.obj</uri></mesh></geometry></visual>
      </link>
    </model>
  </world>
</sdf>
