<?xml version="1.0"?>
<!--
  PLACEHOLDER created by S0 so the top-level xacro builds.
  Owner: S1 (robot model) - replace the macro body; keep the macro name and parameters
  (they are part of the contract used by serabot.urdf.xacro).
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="serabot_camera_mast">
    <joint name="camera_mast_joint" type="fixed">
      <parent link="base_link"/>
      <child link="camera_mast_link"/>
      <origin xyz="-0.15 0 0.06" rpy="0 0 0"/>
    </joint>
    <link name="camera_mast_link"/>
  </xacro:macro>
</robot>
