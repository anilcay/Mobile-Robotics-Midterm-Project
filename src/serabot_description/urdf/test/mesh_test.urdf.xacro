<?xml version="1.0"?>
<!--
  Mesh orientation / colour test (owner: S1, ADR-015). Not part of the robot.
  Four objects in a row along Y, each 0.1 m above the ground, should look identical:
  grey cube, red arrow +X, green arrow +Y, blue cap +Z.
    y = +0.6  ref_primitive  URDF primitives (ground truth)
    y = +0.2  glb_yup        orientation_cube_yup.glb (glTF "+Y Up" export)
    y = -0.2  glb_zup        orientation_cube_zup.glb (raw Blender axes)
    y = -0.6  obj            orientation_cube.obj + .mtl
  RViz:   ros2 launch serabot_description display.launch.py model:=test/mesh_test.urdf.xacro
  Meshes: src/serabot_description/blender/make_orientation_test.py
-->
<robot name="mesh_test" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="../materials.xacro"/>
  <xacro:include filename="../inertial_macros.xacro"/>

  <xacro:property name="cube" value="0.2"/>
  <xacro:property name="mesh_dir" value="package://serabot_description/meshes/test"/>

  <!-- A link holding one test object, fixed to base_footprint at (0, y, cube/2). -->
  <xacro:macro name="test_object" params="name y **visuals">
    <joint name="${name}_joint" type="fixed">
      <parent link="base_footprint"/>
      <child link="${name}"/>
      <origin xyz="0 ${y} ${cube / 2}" rpy="0 0 0"/>
    </joint>
    <link name="${name}">
      <xacro:insert_block name="visuals"/>
      <collision>
        <geometry>
          <box size="${cube} ${cube} ${cube}"/>
        </geometry>
      </collision>
      <xacro:inertial_box mass="1.0" x="${cube}" y="${cube}" z="${cube}"/>
    </link>
  </xacro:macro>

  <xacro:macro name="mesh_visual" params="file">
    <visual>
      <geometry>
        <mesh filename="${mesh_dir}/${file}"/>
      </geometry>
    </visual>
  </xacro:macro>

  <link name="base_footprint"/>

  <xacro:test_object name="ref_primitive" y="0.6">
    <visuals>
      <visual>
        <geometry>
          <box size="${cube} ${cube} ${cube}"/>
        </geometry>
        <xacro:serabot_material name="grey"/>
      </visual>
      <visual>
        <origin xyz="0.2 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.2 0.04 0.04"/>
        </geometry>
        <xacro:serabot_material name="red"/>
      </visual>
      <visual>
        <origin xyz="0 0.15 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.03 0.1 0.03"/>
        </geometry>
        <material name="test_green">
          <color rgba="0.1 0.7 0.1 1.0"/>
        </material>
      </visual>
      <visual>
        <origin xyz="0 0 0.115" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.05" length="0.03"/>
        </geometry>
        <material name="test_blue">
          <color rgba="0.1 0.2 0.9 1.0"/>
        </material>
      </visual>
    </visuals>
  </xacro:test_object>

  <xacro:test_object name="glb_yup" y="0.2">
    <visuals>
      <xacro:mesh_visual file="orientation_cube_yup.glb"/>
    </visuals>
  </xacro:test_object>

  <xacro:test_object name="glb_zup" y="-0.2">
    <visuals>
      <xacro:mesh_visual file="orientation_cube_zup.glb"/>
    </visuals>
  </xacro:test_object>

  <xacro:test_object name="obj" y="-0.6">
    <visuals>
      <xacro:mesh_visual file="orientation_cube.obj"/>
    </visuals>
  </xacro:test_object>

  <!-- Keep the test object still in Gazebo -->
  <gazebo>
    <static>true</static>
  </gazebo>

</robot>
